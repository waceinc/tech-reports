  {
   "id": "P-T18",
   "purpose": "분류 쪽이 정지 상태여도 투입 허가는 켜지고, 토트가 제자리에 없으면 꺼졌다가 토트 교환기 busy 가 켜지면 다시 켜진다.",
   "requirements": ["P-24", "PB-03"],
   "scans": 80,
   "steps": [
    {"at": 20, "set": {"P.Tote.present": false}},
    {"at": 40, "set": {"P.Tote.busy": true}}
   ],
   "expect": [

    {"tag": "P.R0.request", "value": false, "from": 20, "to": 100},
    {"tag": "P.Safety.enable", "value": true, "from": 1, "to": 60},
    {"tag": "P.HMI.faultCode", "value": 0, "from": 1, "to": 60},
    {"tag": "P.HMI.faultCode", "value": 101, "from": 61, "to": 100}
   ]
  },
  {
   "id": "P-T17",
   "purpose": "토트 점유 수가 4 이면 불량 배출이 꺼져 있고 3 으로 내려가면 켜진다.",
   "requirements": ["P-19"],
   "scans": 100,
   "initial": {"P.Tote.count": 4},
   "steps": [
    {"at": 50, "set": {"P.Tote.count": 3}}
   ],
   "expect": [
    {"tag": "P.Reject.gate", "value": false, "from": 1, "to": 49},
    {"tag": "P.Reject.gate", "value": true, "from": 50, "to": 100}
   ]
